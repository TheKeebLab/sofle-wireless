// QWERTZ (German) layout for the sofle, generated from the stock keymap.
// Layer 0 keys stay where they are (the computer's keyboard language decides what they type);
// the other layers type the same characters as the stock keymap. Extra keys:
//   layer 1, key 37: ü
//   layer 1, key 38: ß
//   layer 1, key 39: €
//   layer 1, key 49: ´
/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Wake-up key: top outer corner (` / \), row pin 5, column pin 19 on both halves.
#define TKL_WAKE_ROW 5
#define TKL_WAKE_COL 19
// Switch-off: ` + Ctrl/Esc held together.
#define TKL_OFF_KEYS 0 36
#include "tkl_power.dtsi"
#include "tkl_brightness.dtsi"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define GAMING 4

/ {
    behaviors {
        // Right knob: one mouse-wheel step per notch (wheel_step). On our Sofles the first
        // sensor binding fires on a physical counter-clockwise turn (tested 2026-10-24),
        // so every knob binding below lists counter-clockwise first: clockwise = volume up,
        // scroll down, page down.
        wheel_step: wheel_step {
            compatible = "zmk,behavior-wheel-step";
            #binding-cells = <1>;
        };

        knob_scroll: knob_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&wheel_step 1>, <&wheel_step (-1)>;
        };
    };

    wheel_step_input_listener {
        compatible = "zmk,input-listener";
        device = <&wheel_step>;
    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
&kp GRAVE         &kp N1  &kp N2        &kp N3  &kp N4        &kp N5                             &kp N6         &kp N7      &kp N8     &kp N9         &kp N0    &kp BACKSLASH
&kp TAB           &kp Q   &kp W         &kp E   &kp R         &kp T                              &kp Y          &kp U       &kp I      &kp O          &kp P     &kp RA(NON_US_BSLH)
&kp LEFT_SHIFT    &kp A   &kp S         &kp D   &kp F         &kp G                              &kp H          &kp J       &kp K      &kp L          &kp SEMI  &kp SQT
&mt LCTRL ESCAPE  &kp Z   &kp X         &kp C   &kp V         &kp B   &kp C_MUTE    &kp C_PP     &kp N          &kp M       &kp COMMA  &kp DOT        &kp FSLH  &kp CAPS
                          &kp LEFT_ALT  &mo 2   &kp LEFT_GUI  &mo 1   &kp RET       &kp SPACE    &kp BACKSPACE  &kp DELETE  &mo 1      &kp RIGHT_ALT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&knob_scroll>;
        };

        lower_layer {

            bindings = <
&trans     &trans           &trans       &trans     &trans      &trans                         &trans          &trans          &trans         &trans                &trans                 &trans
&kp LS(EQUAL)  &kp EXCLAMATION  &kp RA(Q)    &kp NON_US_HASH   &kp DOLLAR  &kp PERCENT                    &kp GRAVE       &kp LS(N6)      &kp LS(RBKT)   &kp LS(N8)            &kp LS(N9)             &kp RA(NON_US_BSLH)
&trans     &kp LS(MINUS)     &kp LS(N0)    &kp LS(FSLH)  &kp FSLH    &kp RBKT                       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW       &kp LS(DOT)              &trans
&trans     &kp LBKT            &kp MINUS        &kp RA(E)      &kp RA(N7)    &kp RA(N0)     &trans    &trans  &kp RA(N8)        &kp RA(N9)        &kp NON_US_BSLH  &kp LS(NON_US_BSLH)      &kp RA(MINUS)               &kp EQUAL
                            &trans       &trans     &trans      &trans       &trans    &trans  &trans          &trans          &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        layer_2 {
            bindings = <
&trans  &kp F1    &kp F2       &kp F3         &kp F4   &none                              &none   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp FSLH      &none
&trans  &kp F5    &kp F6       &kp F7         &kp F8   &none                              &none   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RBKT      &none
&trans  &kp F9    &kp F10      &kp F11        &kp F12  &kp PRINTSCREEN                    &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(RBKT)  &none
&trans  &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END  &kp INS          &none     &none   &none   &kp NUMBER_0  &none         &kp DOT       &kp LS(N7)     &none
                 &trans       &trans         &trans   &trans           &trans    &trans  &trans  &trans        &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4           &none  &none  &none  &none  &none  &tog GAMING
&bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                 &none  &none  &none  &none  &none  &none
&none           &out OUT_USB   &out OUT_BLE   &scr_bri       &kp K_SLEEP    &none                  &none  &none  &none  &none  &none  &none
&none           &none          &none          &none          &none          &none  &none    &none  &none  &none  &none  &none  &none  &none
                               &none          &none          &none          &none  &none    &none  &none  &none  &none  &none
            >;
        };

        gaming_layer {
        
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &kp SPACE     &kp RET   &trans  &trans  &trans  &trans
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };
    };
};
